# 1. Dependency folders (Massive folders fetched via package managers)
node_modules/
jspm_packages/
.venv/
env/

# 2. Build and compilation outputs (Generated files that do not belong in source control)
dist/
build/
bin/
obj/
*.exe
*.dll
*.pyc
*.class

# 3. Environment variables and secrets (Crucial to prevent security leaks)
.env
.env.local
*.pem
id_rsa

# 4. System-specific files (Hidden files created by your Operating System)
.DS_Store
Thumbs.db
ehthumbs.db

# 5. IDE and Text Editor configurations (Personal editor setups)
.vscode/
.idea/
*.suo
*.ntvs*

# 6. Logs and temporary diagnostics
*.log
npm-debug.log*
yarn-debug.log*
.eslintcache
