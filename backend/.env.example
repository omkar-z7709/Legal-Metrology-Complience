# Server Configuration
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Direct Postgres / Supabase Connection Pooler)
# Local Docker Postgres: postgresql://postgres:postgrespassword@127.0.0.1:5432/postgres
# Supabase Postgres: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/postgres

# Supabase Configuration
SUPABASE_URL=http://127.0.0.1:54321
